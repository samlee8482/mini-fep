
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot가 제공하는 기본 설정 및 의존성 버전 관리 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <!-- 전체 Mini FEP 프로젝트 정보 -->
    <groupId>com.minifep</groupId>
    <artifactId>mini-fep</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!-- pom: 여러 하위 모듈을 관리하는 부모 프로젝트 -->
    <packaging>pom</packaging>

    <name>mini-fep</name>
    <description>Java 기반 Mini FEP Framework PoC</description>

    <!-- Java 21 사용 -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- 하위 모듈 등록 -->
    <modules>
        <module>fep-core</module>
        <module>business-app</module>
        <module>mock-institution</module>
    </modules>

</project>
