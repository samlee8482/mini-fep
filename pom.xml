<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven POM 파일 형식의 버전. Maven 3에서 일반적으로 4.0.0을 사용한다. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 부모 POM: Spring 및 라이브러리의 호환 버전을 관리한다. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <!-- 상위 디렉터리에서 부모 POM을 찾지 않고 Maven 저장소에서 조회한다. -->
        <relativePath/>
    </parent>

    <!-- groupId: 프로젝트 소속, artifactId: 프로젝트 이름, version: 빌드 버전 -->
    <groupId>com.minifep</groupId>
    <artifactId>mini-fep</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!-- pom: 실행 JAR가 아닌 여러 하위 모듈을 묶는 부모 프로젝트 -->
    <packaging>pom</packaging>
    <name>mini-fep</name>
    <description>Java 기반 Mini FEP Framework PoC</description>

    <!-- 모든 하위 모듈이 동일한 Java 21 컴파일 설정을 상속한다. -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Maven은 아래 세 모듈을 순서와 의존관계에 맞게 함께 빌드한다. -->
    <modules>
        <!-- 기관별 전문 변환과 TCP 통신을 제공하는 공통 라이브러리 -->
        <module>fep-core</module>
        <!-- 공통 라이브러리를 호출하는 Spring Boot 업무 애플리케이션 -->
        <module>business-app</module>
        <!-- 외부 금융기관을 흉내 내는 독립 Java TCP 테스트 서버 -->
        <module>mock-institution</module>
    </modules>

</project>
