<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven POM 파일 형식의 버전. Maven 3에서 일반적으로 4.0.0을 사용한다. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 부모 POM에서 Java 버전, Spring Boot 버전 및 프로젝트 버전을 상속한다. -->
    <parent>
        <groupId>com.minifep</groupId>
        <artifactId>mini-fep</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Spring Boot 기반 업무 호출 프로그램 -->
    <artifactId>business-app</artifactId>
    <!-- 일반 Java 라이브러리 또는 실행 JAR의 기본 패키징 방식 -->
    <packaging>jar</packaging>

    <name>business-app</name>
    <description>Mini FEP Business Application</description>

    <dependencies>
        <!-- Spring Boot 시작 및 CommandLineRunner 실행에 필요한 기본 기능 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!-- 업무 앱은 TCP나 기관별 Mapper를 직접 구현하지 않고 공통 FEP를 참조한다. -->
        <dependency>
            <groupId>com.minifep</groupId>
            <artifactId>fep-core</artifactId>
            <!-- ${project.version}: 현재 프로젝트와 같은 버전 사용 -->
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 의존 라이브러리를 포함하여 java -jar로 실행 가능한 JAR를 만든다. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.5.7</version>
                <executions>
                    <execution>
                        <goals>
                            <!-- package 단계에서 일반 JAR를 실행형 JAR로 다시 묶는다. -->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
