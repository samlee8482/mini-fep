<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 공통 부모의 Java 21, Spring Boot 3.5.7 및 버전 설정 상속 -->
    <parent>
        <groupId>com.minifep</groupId>
        <artifactId>mini-fep</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>business-app</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <!-- REST HTTP 클라이언트(RestClient) 및 JSON 변환에 사용. -->
        <!-- fep-core 의존성은 제거: 업무 앱은 FEP 내부 클래스와 무관하다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>
    <build><plugins><plugin>
        <!-- 실행 가능한 업무 앱 JAR 생성 -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin></plugins></build>
</project>
