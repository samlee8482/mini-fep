<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.minifep</groupId>
        <artifactId>mini-fep</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <!-- REST 진입점 및 FEP 실행 주체 -->
    <artifactId>fep-server</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <!-- 내장 HTTP 서버, @RestController, JSON 직렬화/역직렬화 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 기존 YAML Mapper, 기관별 설정, TCP 송수신 구현을 재사용 -->
        <dependency>
            <groupId>com.minifep</groupId>
            <artifactId>fep-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build><plugins><plugin>
        <!-- java -jar 실행형 JAR 생성 -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin></plugins></build>
</project>
