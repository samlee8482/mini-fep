
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 최상위 Mini FEP 프로젝트의 공통 설정 상속 -->
    <parent>
        <groupId>com.minifep</groupId>
        <artifactId>mini-fep</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- FEP 공통 프레임워크 모듈 -->
    <artifactId>fep-core</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!--
            Spring Boot 설정 기능 사용

            1. @ConfigurationProperties
               외부 YAML 설정을 Java 객체로 변환

            2. @Configuration
               FEP 공통 설정 클래스 선언

            3. @Bean
               InstitutionRegistry, FepService 객체 등록

            fep-core는 Spring Boot 실행 애플리케이션이 아닌
            business-app에서 사용하는 공통 라이브러리이다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!--
            Spring의 Bean 등록 및 설정 기능 사용
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!--
            Spring Boot 자동 설정 기능

            @AutoConfiguration 어노테이션을 사용하여
            business-app 실행 시 FEP 공통 설정을 자동 등록한다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.5.7</version>
        </dependency>

    </dependencies>

</project>
