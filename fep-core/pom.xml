<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven POM 파일 형식의 버전. Maven 3에서 일반적으로 4.0.0을 사용한다. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 부모 POM에서 Java 버전, Spring Boot 버전 및 프로젝트 버전을 상속한다. -->
    <parent>
        <groupId>com.minifep</groupId>
        <artifactId>mini-fep</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- FEP 공통 라이브러리: 설정, Mapper, TCP 통신 -->
    <artifactId>fep-core</artifactId>
    <!-- 일반 Java 라이브러리 또는 실행 JAR의 기본 패키징 방식 -->
    <packaging>jar</packaging>

    <!-- 공통 모듈은 단독 실행하지 않고 FEP 서버의 의존성으로 로딩된다. -->
    <dependencies>
        <!-- Spring Boot의 환경 설정 및 ConfigurationProperties 바인딩 기능 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!-- @Bean, Spring 컨테이너와 의존성 주입 기능 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- @AutoConfiguration으로 FEP 서버 실행 시 FEP 공통 설정 자동 등록 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.5.7</version>
        </dependency>
    </dependencies>

</project>
